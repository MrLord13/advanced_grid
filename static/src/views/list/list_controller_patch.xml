<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="advanced_grid.ListViewColorGridButton"
       t-inherit="web.ListView"
       t-inherit-mode="extension">
        <xpath expr="//Layout" position="before">
            <t t-if="agShowBrand"
               t-portal="'#' + env.dialogId + ' .modal-header .modal-title'">
                <span class="o_ag_brand">
                    <img class="o_ag_brand_logo" t-att-src="agBrandLogo" alt="ERPishro"/>
                    <span class="o_ag_brand_text" t-out="agBrandName"/>
                </span>
            </t>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="inside">
            <button t-if="props.showButtons and agShowColorGridButton"
                    type="button"
                    class="btn btn-secondary o_ag_color_grid_button"
                    title="Personalise the colours and icons of this list"
                    t-on-click="agOpenColorGrid">
                <i class="fa fa-paint-brush me-1" role="img"/>
                <span class="d-none d-md-inline">Color Grid</span>
            </button>
            <t t-if="props.showButtons and agIsRuleList">
                <button type="button"
                        class="btn btn-secondary o_ag_rule_button"
                        title="Open the full form, with the Domain editor and every advanced option"
                        t-on-click="agOpenRuleForm">
                    <i class="fa fa-pencil-square-o me-1" role="img"/>
                    <span class="d-none d-md-inline">Form View</span>
                </button>
                <button type="button"
                        class="btn btn-secondary o_ag_rule_button"
                        title="Duplicate the selected rules"
                        t-att-disabled="!agHasSelection"
                        t-on-click="agDuplicateRules">
                    <i class="fa fa-clone me-1" role="img"/>
                    <span class="d-none d-md-inline">Duplicate</span>
                </button>
                <button type="button"
                        class="btn btn-secondary o_ag_rule_button text-danger"
                        title="Delete the selected rules"
                        t-att-disabled="!agHasSelection"
                        t-on-click="agDeleteRules">
                    <i class="fa fa-trash-o me-1" role="img"/>
                    <span class="d-none d-md-inline">Delete</span>
                </button>
                <button type="button"
                        class="btn btn-link o_ag_rule_button"
                        title="Remove every personal rule on this list"
                        t-on-click="agResetRules">
                    <i class="fa fa-undo me-1" role="img"/>
                    <span class="d-none d-md-inline">Reset This List</span>
                </button>
            </t>
        </xpath>
    </t>

</templates>
