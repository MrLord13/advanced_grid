<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="advanced_grid.FormViewBrand"
       t-inherit="web.FormView"
       t-inherit-mode="extension">
        <xpath expr="//Layout" position="before">
            <t t-if="agShowBrand"
               t-portal="'#' + env.dialogId + ' .modal-header .modal-title'">
                <t t-call="advanced_grid.BrandBox"/>
            </t>
        </xpath>
    </t>

</templates>
