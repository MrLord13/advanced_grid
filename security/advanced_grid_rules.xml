<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        A regular user:
          - reads their own personal rules AND every shared rule;
          - can only create / write / delete their own personal rules.
        Two separate ir.rule records are needed because read and write need
        different domains.
    -->

    <record id="rule_advanced_grid_rule_read" model="ir.rule">
        <field name="name">Advanced Grid: read own personal rules and shared rules</field>
        <field name="model_id" ref="model_advanced_grid_rule"/>
        <field name="domain_force">['|', ('scope', '=', 'shared'), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_advanced_grid_rule_write" model="ir.rule">
        <field name="name">Advanced Grid: only edit own personal rules</field>
        <field name="model_id" ref="model_advanced_grid_rule"/>
        <field name="domain_force">[('scope', '=', 'personal'), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_advanced_grid_rule_manager" model="ir.rule">
        <field name="name">Advanced Grid: manager full access</field>
        <field name="model_id" ref="model_advanced_grid_rule"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('advanced_grid.group_advanced_grid_manager'))]"/>
    </record>

</odoo>
