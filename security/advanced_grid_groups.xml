<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 19 reworked res.groups: `category_id` no longer exists on the group
        itself. A group now points to a `res.groups.privilege`, and it is the
        privilege that carries the `ir.module.category`.
    -->

    <record id="module_category_advanced_grid" model="ir.module.category">
        <field name="name">Advanced Grid</field>
        <field name="description">Manage company wide list view colour schemes.</field>
        <field name="sequence">55</field>
    </record>

    <record id="res_groups_privilege_advanced_grid" model="res.groups.privilege">
        <field name="name">Advanced Grid</field>
        <field name="description">Who may publish shared grid styling rules.</field>
        <field name="category_id" ref="module_category_advanced_grid"/>
        <field name="sequence">100</field>
    </record>

    <record id="group_advanced_grid_manager" model="res.groups">
        <field name="name">Advanced Grid Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_advanced_grid"/>
        <field name="comment">Can create and edit shared (company wide) grid styling rules.</field>
        <!--
            `implied_by_ids` is the reverse of `implied_ids`: administrators
            automatically get this group, without having to write on the base
            group_system record.
        -->
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

</odoo>
